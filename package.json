{
  "name": "learnflow-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "catalog:seed": "node scripts/generate-catalog-seed.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "test:live": "node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/live",
    "ai:check": "node --env-file=.env.local scripts/groq-check.mjs",
    "db:verify": "node --env-file=.env.local scripts/db-verify.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.3",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
