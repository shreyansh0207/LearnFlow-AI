# LearnFlow AI — environment configuration
# Copy to .env.local for local development. Never commit real values.
# Every variable here is SERVER-ONLY except those starting with NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# Neon Postgres (required) — all data lives here: accounts, sessions,
# learning history and the knowledge catalog.
# Use the POOLED connection string (host contains "-pooler") for the app.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Optional: direct (non-pooler) URL for migrations. If unset, it is derived from
# DATABASE_URL by removing "-pooler".
# DATABASE_URL_UNPOOLED=
# Optional: max connections per server instance (default 10).
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Google Gemini (required for AI features) — https://aistudio.google.com/apikey
# Never prefix with NEXT_PUBLIC_: the key must never reach the browser.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Model to use. Verify it's usable by your key with: npm run ai:check
# (a model can appear in the model list yet be unavailable to new keys).
GEMINI_MODEL=gemini-3.5-flash
# Optional: minimal | low | medium | high (default low = faster, cheaper).
GEMINI_THINKING_LEVEL=low
# Optional: per-user AI request limit per rolling hour (default 40).
AI_RATE_LIMIT_PER_HOUR=40

# Optional: only used when GEMINI_API_KEY is empty. "true" enables clearly
# labelled TEMPLATE content so the flow can be tested without AI.
LEARNFLOW_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Sources and site
# ---------------------------------------------------------------------------
# Source retrieval for curricula (Wikipedia + OpenAlex public APIs). "off" disables it.
SOURCE_RETRIEVAL=on
# Optional contact email sent to OpenAlex, per their API etiquette.
SOURCE_CONTACT_EMAIL=
# Public site URL (used in reset links and the source-lookup user agent).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Register the service worker during `next dev`.
NEXT_PUBLIC_ENABLE_SW_IN_DEV=false
